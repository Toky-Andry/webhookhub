# Copy this file to .env and replace every "change-me" value.
# Use letters and digits only in passwords (special characters break the URLs below).
POSTGRES_USER=webhookhub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=webhookhub
REDIS_PASSWORD=change-me-redis

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgres://webhookhub:change-me-postgres@127.0.0.1:5433/webhookhub
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
